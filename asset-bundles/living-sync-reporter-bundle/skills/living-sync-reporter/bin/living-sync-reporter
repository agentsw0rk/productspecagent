#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
os=$(uname -s | tr '[:upper:]' '[:lower:]')
arch=$(uname -m)

case "$os" in
  linux*) os="linux" ;;
  darwin*) os="darwin" ;;
  *) echo "Unsupported OS: $os" >&2; exit 1 ;;
esac

case "$arch" in
  x86_64|amd64) arch="amd64" ;;
  arm64|aarch64) arch="arm64" ;;
  *) echo "Unsupported architecture: $arch" >&2; exit 1 ;;
esac

target="$os-$arch"
binary_path="$script_dir/$target/living-sync-reporter"

if [ ! -x "$binary_path" ]; then
  echo "Missing or non-executable Living Sync reporter binary: $binary_path" >&2
  exit 1
fi

exec "$binary_path" "$@"
